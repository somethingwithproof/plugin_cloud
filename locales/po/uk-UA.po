#: lib/AccountInput.php
msgid "Provider: choose one of the listed providers."
msgstr "Постачальник: виберіть одного з перелічених постачальників."

#: lib/AccountInput.php
msgid "Name: enter 1 to 100 characters without control characters."
msgstr "Назва: введіть від 1 до 100 символів без керівних символів."

#: lib/AccountInput.php
msgid "Poller: only the main poller can collect cloud accounts in this release."
msgstr "Опитувач: у цьому випуску збирати дані хмарних облікових записів може лише головний опитувач."

#: lib/AccountInput.php
#, php-format
msgid "%s: the value does not have the form this provider uses."
msgstr "%s: значення не відповідає формату, який використовує цей постачальник."

#: lib/AccountInput.php
msgid "Credential Source: choose one this provider supports."
msgstr "Джерело облікових даних: виберіть джерело, яке підтримує цей постачальник."

#: lib/AccountInput.php
msgid "Credential File: enter an absolute path without control characters, at most 512 characters."
msgstr "Файл облікових даних: введіть абсолютний шлях без керівних символів завдовжки щонайбільше 512 символів."

#: lib/AccountInput.php
#, php-format
msgid "%s: enter whole seconds from %d to %d."
msgstr "%s: введіть цілу кількість секунд від %d до %d."

