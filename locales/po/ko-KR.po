msgstr "자격 증명 소스: 이 공급자가 지원하는 항목 중 하나를 선택하세요."

#: lib/AccountInput.php
msgid "Credential File: enter an absolute path without control characters, at most 512 characters."
msgstr "자격 증명 파일: 제어 문자 없이 최대 512자의 절대 경로를 입력하세요."

#: lib/AccountInput.php
#, php-format
msgid "%s: enter whole seconds from %d to %d."
msgstr "%s: %d에서 %d 사이의 정수 초를 입력하세요."

