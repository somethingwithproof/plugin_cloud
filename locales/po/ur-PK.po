msgstr "ان انسٹال پر پلگ ان ٹیبلز برقرار رکھیں"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its accounts, encrypted credentials, and cache. Clear it to have the uninstall drop them. Cloud resources are never touched either way."
msgstr "جب نشان زد ہو، تو پلگ ان کو ان انسٹال کرنے پر اس کے اکاؤنٹس، انکرپٹڈ کریڈینشلز، اور کیش برقرار رہتے ہیں۔ ان انسٹال کے وقت انہیں حذف کرنے کے لیے نشان ہٹا دیں۔ دونوں صورتوں میں Cloud وسائل کو کبھی ہاتھ نہیں لگایا جاتا۔"

#: lib/VerifyStatus.php
msgid "Not verified yet."
msgstr "ابھی تک تصدیق نہیں ہوئی۔"

#: lib/VerifyStatus.php
msgid "The credential works and has the permissions this account needs."
msgstr "کریڈینشل کام کر رہا ہے اور اس کے پاس وہ اجازتیں موجود ہیں جن کی اس اکاؤنٹ کو ضرورت ہے۔"

#: lib/VerifyStatus.php
msgid "The provider rejected the credential. It may be wrong, expired, or revoked."
msgstr "پرووائیڈر نے کریڈینشل کو مسترد کر دیا۔ یہ غلط، میعاد ختم شدہ، یا منسوخ ہو سکتا ہے۔"

#: lib/VerifyStatus.php
msgid "The credential works but lacks a permission this account needs."
msgstr "کریڈینشل کام کر رہا ہے لیکن اس میں ایک ایسی اجازت کی کمی ہے جس کی اس اکاؤنٹ کو ضرورت ہے۔"

#: lib/VerifyStatus.php
msgid "The provider could not be reached. Check the network path and outbound policy from the poller."
msgstr "پرووائیڈر تک رسائی حاصل نہیں ہو سکی۔ پولر سے نیٹ ورک کا راستہ اور آؤٹ باؤنڈ پالیسی چیک کریں۔"

#: lib/VerifyStatus.php
msgid "The provider is throttling requests. Try again later."
msgstr "پرووائیڈر درخواستوں کو محدود کر رہا ہے۔ بعد میں دوبارہ کوشش کریں۔"

#: lib/VerifyStatus.php
msgid "The provider sent a response the plugin could not read."
msgstr "پرووائیڈر نے ایسا جواب بھیجا جسے پلگ ان پڑھ نہیں سکا۔"

#: lib/VerifyStatus.php
msgid "The account or its credential is not configured correctly."
msgstr "اکاؤنٹ یا اس کا کریڈینشل درست طریقے سے کنفیگر نہیں ہے۔"

#: setup.php
#, php-format
msgid "The Cloud plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Cloud پلگ ان کے لیے PHP %s یا اس سے جدید ورژن درکار ہے۔ یہ سرور PHP %s چلا رہا ہے، اس لیے پلگ ان انسٹال یا فعال نہیں کیا گیا۔"

#: setup.php
#, php-format
msgid "The Cloud plugin requires the PHP extensions %s, which this server does not load, so the plugin was not installed or enabled."
msgstr "Cloud پلگ ان کے لیے PHP ایکسٹینشنز %s درکار ہیں، جنہیں یہ سرور لوڈ نہیں کرتا، اس لیے پلگ ان انسٹال یا فعال نہیں کیا گیا۔"

#: setup.php
msgid "Cloud"
msgstr "Cloud"

#: setup.php
msgid "The Cloud plugin is not enabled."
msgstr "Cloud پلگ ان فعال نہیں ہے۔"

#: setup.php
#, php-format
msgid "The Cloud plugin requires PHP %s or later."
msgstr "Cloud پلگ ان کے لیے PHP %s یا اس سے جدید ورژن درکار ہے۔"

#: setup.php
msgid "Management"
msgstr "انتظام"
